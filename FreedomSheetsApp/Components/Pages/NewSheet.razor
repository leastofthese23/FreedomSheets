<script>
    var MenuOpen = false;
    var ContextMenuActive = "context-menu--active";
    var MenuElement = document.querySelector("#context-menu");
    var UniqueIdCounter = 4;
    var VerseTemplate;


    function wait(ms){
        var start = new Date().getTime();
        var end = start;
        while(end < start + ms) {
            end = new Date().getTime();
        }
    }



    function logToConsole(message) {
        console.log(message);
    }


    function clickInsideElement(e, className) {
        var el = e.srcElement || e.target;

        if (el.classList.contains(className)) {
            return el;
        } else {
            while (el = el.parentNode) {
                if (el.classList && el.classList.contains(className)) {
                    return el;
                }
            }
        }

        return false;
    }


    function getPosition(e) {
        var posx = 0;
        var posy = 0;

      if (!e) var e = window.event;

      if (e.pageX || e.pageY) {
          posx = e.pageX;
          posy = e.pageY;
      } else if (e.clientX || e.clientY) {
          posx = e.clientX + document.body.scrollLeft + document.documentElement.scrollLeft;
          posy = e.clientY + document.body.scrollTop + document.documentElement.scrollTop;
      }

      return {
          x: posx,
          y: posy
      }
    }


    function init() {
        fetch('../verse.html') // TODO: make web address dynamic
            .then(response => response.text())
            .then((data) => {
                console.log(`data = ${data}`);
                console.log(`data.text = ${data.text}`);
                VerseTemplate = data;
            });

        contextListener();
        //console.log('init - adding click listener.');
        clickListener();
        //console.log('init - finished adding click listener. calling keyupListener...');
        keyupListener();
        //console.log('init - finished adding ckeyupListener. calling resizeListener...');
        resizeListener();
        //console.log('init - finished adding resizeListener. exiting init...');
    }


    function contextListener() {
        document.addEventListener("contextmenu", function(e) {
            console.log('contextListener 0');
            //var taskItemInContext = clickInsideElement(e, "task"); // this should check if the click is on one of the context menu items, but instead causes the menu to never open.
            console.log('contextListener 0.5');

            //if (taskItemInContext) {
                if (MenuOpen) {
                    console.log('contextListener - Menu is open');
                    //taskItemInContext = null;
                    console.log('contextListener - toggling menu off...');
                    toggleMenuOff();
                    //console.log('contextListener 6');
                
                } else {
                    console.log('contextListener - Menu is NOT open');
                    e.preventDefault();
                    console.log('contextListener - toggling menu on...');
                    toggleMenuOn();
                    //console.log('contextListener 3');
                    positionMenu(e);
                }
            //}

            console.log('contextListener 7');
        });
    }


    function clickListener() {
        document.addEventListener("click", function(e) {
            console.log('clickListener 10');
            var clickeElIsLink = clickInsideElement(e, "context-menu__link"); // TODO: change all var to let
            //console.log('clickListener 11');

            if (clickeElIsLink) {
                console.log('clickListener 12');
                e.preventDefault();
                //console.log('clickListener - calling menuItemListener...');
                menuItemListener(clickeElIsLink); // this is where the text "add-verse" is getting logged to the console
                console.log('clickListener - just finished calling menuItemListener. Exiting...');
                //wait(5000);
            } else {
                //console.log('clickListener 15');
                var button = e.which || e.button;
                console.log('clickListener 16');
                if (button === 1) {
                    console.log('clickListener - button === 1. tolggling menu off...');
                    toggleMenuOff();
                    console.log('clickListener 18');
                }
            }
        });
    }


    // If user presses esc button then close the menu
    function keyupListener() {
        window.onkeyup = function(e) {
            if (e.keyCode === 27) {
                console.log('keyupListener - toggling menu off...');
                toggleMenuOff();
            }
        }
    }


    // If the user is resizing the browser window then close the context menu for now.
    function resizeListener() {
        window.onresize = function(e) {
            console.log('resizeListener - toggling menu off...');
            toggleMenuOff();
        };
    }


    // Safe method for toggling on the context menu. Does check first to make sure menu is closed before attempting to open.
    function toggleMenuOn() {
        if (!MenuOpen) {
            console.log('toggleMenuOn - Menu is not open. Adding classList and setting MenuOpen to true...');
            console.log('toggleMenuOn - adding classList...');
            MenuElement.classList.add(ContextMenuActive);
            MenuOpen = true;
            console.log('toggleMenuOn - finished adding classList.');
        } else {
            console.log('toggleMenuOn - menu is already open.');
        }
    }

    
    // Safe method for toggling off the context menu. Does check first to make sure menu is open before attempting to close.
    function toggleMenuOff() {
        console.log('toggleMenuOff 1');

        if (MenuOpen) {
            console.log('toggleMenuOff - Menu is open. Removing classList and setting MenuOpen to false...');
            console.log('toggleMenuOff - removing context menu...');
            //wait(5000);
            MenuElement.classList.remove(ContextMenuActive); // this doesn't seem to be causing an issue. Page still redirects, even when this is commented out.
            MenuOpen = false;
            console.log('toggleMenuOff - the context menu was just removed. Exiting toggleMenuOff...');
            //wait(5000);
        } else {
            console.log('toggleMenuOff - the menu is already closed.');
        }
    }


    function positionMenu(e) {
        var clickCoords = getPosition(e);
        var clickCoordsX = clickCoords.x;
        var clickCoordsY = clickCoords.y;

        var menuWidth = MenuElement.offsetWidth + 4;
        var menuHeight = MenuElement.offsetHeight + 4;

        var windowWidth = window.innerWidth;
        var windowHeight = window.innerHeight;

        if ((windowWidth - clickCoordsX) < menuWidth) {
            MenuElement.style.left = windowWidth - menuWidth + "px";
        } else {
            MenuElement.style.left = clickCoordsX + "px";
        }

        if ((windowHeight - clickCoordsY) < menuHeight) {
            MenuElement.style.top = windowHeight - menuHeight + "px";
        } else {
            MenuElement.style.top = clickCoordsY + "px";
        }
    }


    // Function called to take an action from clicking on one of the menu items. After action is taken, closes the menu.
    function menuItemListener(link) {
        console.log(link.getAttribute("data-action")); // this is where the data action attribute is logged to the console.

        var sheetMusicWrapperDiv = document.getElementById('sheet-music-wrapper');

        if (sheetMusicWrapperDiv){
            console.log('sheetMusicWrapperDiv found.');
        } else {
            console.log('sheetMusicWrapperDiv NOT found.');
        }

        let newDiv = document.createElement('div');
        newDiv.innerHTML = VerseTemplate;
        console.log('Just created newDiv.');

        newDiv.id = `block-section-${UniqueIdCounter}`;
        UniqueIdCounter++;
        //newDiv.innerHTML = '<p>CreateElement example</p>';
        sheetMusicWrapperDiv.appendChild(newDiv);

        console.log('menuItemListener  - toggling menu off...');
        //wait(5000);
        toggleMenuOff();
        console.log('menuItemListener - the menu was just toggled off. Exiting...');
        //wait(5000);
    }



</script>





